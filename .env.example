# ---------------------------------------------------------------------------
# ChordMini local edition environment variables
# ---------------------------------------------------------------------------
# This fork runs entirely on your own machine: Flask + SQLite + local model
# weights, with no cloud service, no API key and no outbound request. So no
# Firebase / Gemini / Music.ai / YouTube credential belongs in this file.
#
# Usage: copy this to `.env.local` (Next.js loads it automatically) and adjust
# the addresses as needed.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------

# Python backend address (port 5001 avoids the port macOS reserves for AirPlay).
# Used by server-side routes only; do NOT add a NEXT_PUBLIC_ prefix, or it ends
# up in the browser bundle.
PYTHON_API_URL=http://127.0.0.1:5001

# The address the frontend uses for its own absolute links. Use 127.0.0.1:
# a local `localhost` can be intercepted by a proxy.
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Optional: directory for debug logs. dbg(tag, data) -> /api/debug-log appends
# JSONL, default /tmp/chordmini-debug.log. Purely local, no outbound request;
# leave it unset if you do not need diagnostics.
# CHORDMINI_DEBUG_DIR=/tmp

# Deprecated switches the code still reads (keep the defaults)
# NEXT_PUBLIC_ENABLE_EXPERIMENTAL_MODELS=false
