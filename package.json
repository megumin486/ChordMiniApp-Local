{
  "name": "chord-mini-app",
  "version": "0.6.5",
  "private": true,
  "sideEffects": [
    "*.css",
    "*.scss",
    "./src/styles/**/*",
    "./src/app/globals.css"
  ],
  "scripts": {
    "dev": "next dev --webpack -p 3000",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "jest __tests__/unit",
    "test:integration": "jest __tests__/integration",
    "test:e2e": "playwright test --config __tests__/playwright.config.ts",
    "test:e2e:ui": "playwright test --config __tests__/playwright.config.ts --ui",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10"
  },
  "dependencies": {
    "@emotion/is-prop-valid": "^1.3.1",
    "@heroui/react": "^2.7.11",
    "@heroui/theme": "^2.4.16",
    "@tanstack/react-query": "^5.100.10",
    "@tombatossals/chords-db": "^0.5.1",
    "@tombatossals/react-chords": "^0.2.10",
    "clsx": "^2.1.0",
    "comlink": "^4.4.2",
    "framer-motion": "^11.18.2",
    "jspdf": "^4.2.1",
    "music-metadata": "^11.3.0",
    "next": "^16.2.12",
    "ogl": "^1.0.11",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-player": "^2.15.1",
    "react-resizable-panels": "^2.1.9",
    "smplr": "^0.16.3",
    "tailwind-merge": "^2.2.1",
    "three": "^0.184.0",
    "tone": "^15.1.22",
    "yaml": "^2.9.0",
    "zustand": "^4.5.2"
  },
  "overrides": {
    "@tootallnate/once": "3.0.1",
    "brace-expansion": "5.0.8",
    "google-gax": "5.0.6",
    "http-proxy-agent": "9.0.0",
    "js-yaml": "^4.2.0",
    "postcss": "$postcss",
    "retry-request": "8.0.2",
    "teeny-request": "10.1.2",
    "test-exclude": {
      "minimatch": "3.1.5"
    },
    "uuid": "14.0.0",
    "sharp": "$sharp"
  },
  "devDependencies": {
    "@babel/core": "^7.27.7",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/eslintrc": "^3.3.4",
    "@next/bundle-analyzer": "^15.3.5",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "autoprefixer": "^10.4.21",
    "babel-jest": "^29.7.0",
    "cssnano": "^7.1.0",
    "eslint": "^10.0.2",
    "eslint-config-next": "^16.1.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "^16.0.0",
    "jest-watch-typeahead": "^2.2.2",
    "postcss": "^8.5.12",
    "postcss-import": "^16.1.1",
    "postcss-preset-env": "^10.2.4",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.3.3",
    "typescript": "^5"
  }
}
